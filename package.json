{
  "name": "form-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assembles on-brand, print-ready field guides, quick reference sheets and huddle cards from filled-out forms. Entirely client-side.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "geometry": "vite-node scripts/geometry-table.ts",
    "sample": "vite-node scripts/sample.ts",
    "shots": "node scripts/shot.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
